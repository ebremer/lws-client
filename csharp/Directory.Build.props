<!-- SPDX-License-Identifier: MIT -->
<!-- Settings shared by every project under csharp/: the library, its tests and the examples. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Authors>Erich Bremer</Authors>
    <Copyright>Copyright (c) Erich Bremer</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ebremer/lws-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ebremer/lws-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
