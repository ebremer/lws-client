<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Ebremer.Lws.Client</AssemblyName>
    <RootNamespace>Ebremer.Lws</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Ebremer.Lws.Client</PackageId>
    <Version>0.1.0</Version>
    <Title>LWS Client for .NET</Title>
    <Description>Client for the W3C Linked Web Storage (LWS) Protocol 1.0: discovery, resources, containers,
      linksets, OAuth 2.0 token exchange with OpenID Connect / SAML / self-signed (CID, did:key) credentials,
      webhook notifications with RFC 9421 signature verification, access requests and grants, and type index /
      search services.</Description>
    <PackageTags>lws;linked-web-storage;solid;w3c;oauth;token-exchange;did-key;http-message-signatures</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ebremer.Lws.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ed25519 (EdDSA): .NET 10 has none; everything else uses the BCL (ECDsa, SHA256/512, System.Text.Json, HttpClient). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
