    "expectedExpiresIn": 3600
  },
  "tokenResponseNoExpiry": {
    "description": "No expires_in: the expiry comes from the access token's JWT 'exp' claim (1735686300).",
    "body": { "access_token": "eyJ0eXAiOiJhcytqd3QiLCJhbGciOiJFUzI1NiJ9.eyJleHAiOjE3MzU2ODYzMDB9.c2ln", "token_type": "bearer" },
    "expectedExp": 1735686300
  },
  "errorResponse": { "status": 400, "body": { "error": "invalid_request", "error_description": "resource is not a known storage" } },
  "protectedResourceMetadata": {
    "description": "The lws10-core example. 'authorizationServers' keeps the order of authorization_servers; unknown members are kept in the raw document.",
    "body": {
      "resource": "https://storage.example/storage_1/photos/img.jpg",
      "authorization_servers": ["https://authorization.example", "https://backup-as.example/tenant"],
      "bearer_methods_supported": ["header"],
      "resource_name": "Photos"
    },
    "expected": {
      "resource": "https://storage.example/storage_1/photos/img.jpg",
      "authorizationServers": ["https://authorization.example", "https://backup-as.example/tenant"]
    }
  },
  "protectedResourceMetadataInvalid": {
    "description": "Each must be rejected: lws10-core makes authorization_servers REQUIRED with at least one issuer, and RFC 9728 makes resource REQUIRED.",
    "noResource": { "authorization_servers": ["https://authorization.example"] },
    "resourceNotAString": { "resource": ["https://storage.example/a"], "authorization_servers": ["https://authorization.example"] },
    "noAuthorizationServers": { "resource": "https://storage.example/a" },
    "emptyAuthorizationServers": { "resource": "https://storage.example/a", "authorization_servers": [] },
    "authorizationServersNotAnArray": { "resource": "https://storage.example/a", "authorization_servers": "https://authorization.example" },
    "notAnObject": ["https://storage.example/a"]
  },
  "originChecks": [
