    "jwks_uri": "https://authorization.example/jwks",
    "claims_supported": ["sub", "iss", "client_id", "aud"],
    "response_types_supported": ["token"],
    "subject_token_types_supported": ["urn:ietf:params:oauth:token-type:jwt", "urn:ietf:params:oauth:token-type:id_token"],
    "subject_identifier_types_supported": ["did:web", "did:key", "https"]
  },
  "metadataUrls": [
    { "issuer": "https://authorization.example", "url": "https://authorization.example/.well-known/lws-configuration" },
    { "issuer": "https://authorization.example/", "url": "https://authorization.example/.well-known/lws-configuration" },
    { "issuer": "https://as.example/tenant/one", "url": "https://as.example/.well-known/lws-configuration/tenant/one" },
    { "issuer": "http://localhost:8787", "url": "http://localhost:8787/.well-known/lws-configuration" }
  ],
  "tokenResponse": {
