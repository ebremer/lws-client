        },
        "{A}/storage_1": {
          "status": 200,
          "headers": { "content-type": "application/lws+cid" },
          "body": {
            "@context": ["https://www.w3.org/ns/cid/v1", "https://www.w3.org/ns/lws/v1"],
            "id": "{A}/storage_1",
            "type": "Storage",
            "service": [{ "type": "StorageRoot", "serviceEndpoint": "{A}/storage_1/" }]
          }
        },
        "{A}/.well-known/lws-configuration/as": {
          "status": 200,
          "headers": { "content-type": "application/json" },
          "body": {
            "issuer": "{A}/as",
            "token_endpoint": "{A}/as/token",
            "grant_types_supported": ["urn:ietf:params:oauth:grant-type:token-exchange"],
            "subject_token_types_supported": ["urn:ietf:params:oauth:token-type:jwt", "urn:ietf:params:oauth:token-type:id_token", "urn:ietf:params:oauth:token-type:saml2"]
          }
        },
        "{A}/.well-known/oauth-protected-resource/services/inbox": {
          "status": 200,
          "headers": { "content-type": "application/json" },
          "body": { "resource": "{A}/services/inbox", "authorization_servers": ["{A}/as"] }
        }
      },
      "expected": {
        "outcome": "ok",
        "tokenRequest": { "endpoint": "{A}/as/token", "resource": "{A}/storage_1" },
        "notFetched": [],
        "then": [{ "request": "{A}/services/other", "sendsToken": false }, { "request": "{A}/storage_1/notes/a.txt", "sendsToken": true }]
      }
    },
