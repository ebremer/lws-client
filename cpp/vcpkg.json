{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "lws-client",
  "version": "0.1.0",
  "description": "C++20 client for the W3C Linked Web Storage (LWS) protocol",
  "homepage": "https://github.com/ebremer/lws-client",
  "license": "MIT",
  "builtin-baseline": "2e6fcc44573d091af0321f99c89b212997a76f1f",
  "dependencies": [
    "nlohmann-json"
  ],
  "default-features": [
    "curl",
    "openssl"
  ],
  "features": {
    "curl": {
      "description": "Default HTTP transport based on libcurl",
      "dependencies": [
        {
          "name": "curl",
          "default-features": false,
          "features": [
            "ssl"
          ]
        }
      ]
    },
    "openssl": {
      "description": "Cryptography (self-signed JWT credentials, did:key, webhook signature verification) via OpenSSL 3",
      "dependencies": [
        "openssl"
      ]
    },
    "tests": {
      "description": "Build the GoogleTest test suite",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
